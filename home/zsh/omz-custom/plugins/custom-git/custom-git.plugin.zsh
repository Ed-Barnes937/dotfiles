# List all PRs with the dev-review-required label, sorted by additions
alias ghprr='gh pr list --label "dev-review-required" --state open --limit 100 --json number,title,additions,deletions,url | jq -r '"'"'.[] | "\(.additions)|\(.deletions)|\(.title)|\(.url)"'"'"' | sort -n -t"|" -k1 | awk -F"|" '"'"'BEGIN {printf "\033[32m%-6s\033[0m \033[31m%-6s\033[0m %s\n", "ADD", "DEL", "TITLE"; print "--------------------------------------------------------------------------------"} {printf "\033[32m%-6s\033[0m \033[31m%-6s\033[0m %s\n", $1, $2, $3; printf "       %s\n", $4}'"'"
