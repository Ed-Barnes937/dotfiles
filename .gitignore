# Runtime state written by tools whose config dirs are symlinked into this repo.
# Only hand-written config belongs in git; anything a tool rewrites while running
# does not, or every run leaves a dirty tree.

# herdr: ~/.config/herdr is an out-of-store symlink to home/.config/herdr,
# so herdr writes its logs, sockets and session state straight into the repo.
home/.config/herdr/*.log
home/.config/herdr/*.sock
home/.config/herdr/session.json
home/.config/herdr/.plugins.lock
# Plugin installs are managed by herdr: plugins.json records absolute paths,
# resolved commits and install timestamps, and plugins/ holds shallow clones
# complete with their own .git. Neither is portable to another machine.
home/.config/herdr/plugins.json
home/.config/herdr/plugins/

# Skills synced down from the Claude account, keyed by bucket UUID and
# refreshed automatically. Hand-written skills live in home/.claude/skills/.
home/.claude/skills/synced/

# macOS
.DS_Store

# Python bytecode from skills that ship scripts (skill-creator, excalidraw-diagram)
__pycache__/
*.pyc
